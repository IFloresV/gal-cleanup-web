---
import ButtonContact from '@/components/ButtonContact.astro';
import Layout from '@layouts/Layout.astro';
import { siteConfigData } from '@/utils/site-config.jsx';
import { generateServiceSchema } from '@/utils/seo.jsx';

const serviceSchema = generateServiceSchema({
   name: 'Servicios profesionales de limpieza en CDMX',
   description:
      'Gal-Cleanup ofrece servicios de limpieza residencial, comercial y de oficinas con personal profesional capacitado en Ciudad de México.',
});

const services = [
   {
      title: 'Limpieza Residencial',
      desc: 'Dejamos tu hogar impecable, cuidando cada rincón con productos de alta calidad.',
      img: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&q=80',
      tag: 'Hogares',
   },
   {
      title: 'Limpieza Comercial',
      desc: 'Espacios comerciales limpios y ordenados que transmiten confianza a tus clientes.',
      img: 'https://images.unsplash.com/photo-1527515637462-cff94aca208b?w=600&q=80',
      tag: 'Negocios',
   },
   {
      title: 'Limpieza de Oficinas',
      desc: 'Ambientes de trabajo higiénicos que impulsan la productividad de tu equipo.',
      img: 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=600&q=80',
      tag: 'Corporativo',
   },
   {
      title: 'Limpieza Post-Obra',
      desc: 'Retiro de escombros, polvo y residuos tras remodelaciones o construcciones.',
      img: 'https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=600&q=80',
      tag: 'Especializada',
   },
];

const stats = [
   { value: '500+', label: 'Clientes satisfechos' },
   { value: '10+', label: 'Años de experiencia' },
   { value: '98%', label: 'Tasa de satisfacción' },
   { value: '24h', label: 'Atención al cliente' },
];

const reasons = [
   'Personal capacitado y con verificación de antecedentes.',
   'Productos de limpieza ecológicos y biodegradables.',
   'Puntualidad garantizada en cada visita.',
   'Presupuesto sin costo y sin compromisos.',
   'Seguimiento post-servicio para tu tranquilidad.',
];

const industries = [
   { name: 'Residencias', icon: '🏠' },
   { name: 'Oficinas', icon: '🏢' },
   { name: 'Restaurantes', icon: '🍽️' },
   { name: 'Hoteles', icon: '🏨' },
   { name: 'Clínicas', icon: '🏥' },
   { name: 'Eventos', icon: '🎉' },
];

const pillars = [
   {
      icon: '🎯',
      title: 'Misión',
      text: 'Brindar la satisfacción del cliente, haciendo realidad las expectativas en cualquier trabajo que apliquemos.',
   },
   {
      icon: '🔭',
      title: 'Visión',
      text: 'Posicionarnos entre las mejores empresas proveedoras en servicios de limpieza y mantenimiento apoyando el medio ambiente.',
   },
   {
      icon: '🎓',
      title: 'Capacitación',
      text: 'Brindamos capacitación constante, actualizando con temas a la vanguardia, para dar el mejor servicio.',
   },
   {
      icon: '🌿',
      title: 'Productos',
      text: 'Proporcionamos y aplicamos productos de calidad en apoyo al medioambiente.',
   },
   { icon: '📋', title: 'Bitácora y reportes', text: 'Damos un seguimiento administrativo para un mayor control.' },
   { icon: '✅', title: 'Servicios', text: 'Los servicios se adaptan a las necesidades del cliente.' },
];
---

<Layout
   title="Gal-Cleanup | Servicios Profesionales de Limpieza en CDMX"
   description="Gal-Cleanup ofrece limpieza residencial, comercial y de oficinas en Ciudad de México. Personal certificado, productos ecológicos y resultados garantizados."
   type="website"
   schema={serviceSchema}
>
   <!-- ─── HERO ─────────────────────────────────────────────────────────────── -->
   <section class="relative overflow-hidden bg-white min-h-screen flex items-center py-20 px-4 md:px-12 lg:px-20">
      <!-- Fondo decorativo -->
      <div class="absolute inset-0 pointer-events-none">
         <div class="absolute top-0 right-0 w-1/2 h-full bg-brand-50 rounded-bl-[80px] hidden md:block"></div>
         <div class="absolute top-20 right-8 w-4 h-4 bg-brand-400 rounded-full opacity-60"></div>
         <div class="absolute bottom-24 left-12 w-6 h-6 bg-brand-300 rounded-full opacity-40"></div>
         <div class="absolute top-40 left-1/4 w-2 h-2 bg-brand-500 rounded-full opacity-50"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
         <!-- Texto -->
         <div data-aos="fade-right" data-aos-duration="900">
            <span
               class="inline-block bg-brand-100 text-brand-800 text-xs font-semibold tracking-widest uppercase px-4 py-1.5 rounded-full mb-6"
            >
               Servicios de limpieza profesional
            </span>
            <h1 class="text-4xl md:text-5xl xl:text-6xl font-extrabold text-dark leading-tight mb-6">
               Espacios limpios –<br />
               <em class="not-italic text-brand-700">Ambientes que inspiran.</em>
            </h1>
            <p class="text-gray-600 text-lg mb-8 max-w-xl leading-relaxed">
               Gal-Cleanup es una empresa especializada en limpieza profesional para hogares, oficinas y negocios en
               CDMX. Resultados garantizados en cada visita.
            </p>

            <div class="flex flex-wrap gap-4 mb-10">
               <a
                  href={`https://wa.me/${siteConfigData.contacto.WHATSAPP.replace(/\D/g, '')}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 bg-brand-700 hover:bg-brand-800 text-white font-semibold px-7 py-3.5 rounded-full transition-all duration-300 shadow-lg hover:shadow-brand-700/40 hover:-translate-y-0.5"
               >
                  Cotiza ahora &rarr;
               </a>
               <a
                  href="#servicios"
                  class="inline-flex items-center gap-2 border-2 border-brand-700 text-brand-700 hover:bg-brand-700 hover:text-white font-semibold px-7 py-3.5 rounded-full transition-all duration-300"
               >
                  Ver servicios
               </a>
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2">
               {
                  ['Profesional', 'Puntual', 'Ecológico', 'Garantizado'].map((tag) => (
                     <span class="bg-white border border-brand-200 text-brand-700 text-xs font-medium px-4 py-1.5 rounded-full shadow-sm">
                        {tag}
                     </span>
                  ))
               }
            </div>
         </div>

         <!-- Imagen hero -->
         <div class="relative" data-aos="fade-left" data-aos-duration="900" data-aos-delay="100">
            <div class="relative rounded-3xl overflow-hidden shadow-2xl aspect-[4/5] max-h-[600px]">
               <img
                  src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=800&q=85"
                  alt="Servicio de limpieza profesional Gal-Cleanup"
                  class="w-full h-full object-cover"
                  loading="eager"
               />
               <div class="absolute inset-0 bg-gradient-to-t from-brand-900/30 to-transparent"></div>
            </div>

            <!-- Floating card -->
            <div
               class="absolute -bottom-4 -left-4 md:-left-10 bg-white rounded-2xl shadow-xl p-4 flex items-center gap-3 max-w-xs"
               data-aos="fade-up"
               data-aos-delay="400"
            >
               <div class="w-12 h-12 bg-brand-100 rounded-xl flex items-center justify-center text-2xl flex-shrink-0">
                  ✨
               </div>
               <div>
                  <p class="font-bold text-dark text-sm">+500 clientes felices</p>
                  <p class="text-gray-500 text-xs">en toda la CDMX</p>
               </div>
            </div>

            <!-- Floating rating -->
            <div
               class="absolute -top-4 -right-4 md:-right-6 bg-brand-700 text-white rounded-2xl shadow-xl p-4 text-center"
               data-aos="fade-down"
               data-aos-delay="400"
            >
               <p class="text-3xl font-extrabold">98%</p>
               <p class="text-xs text-brand-200 mt-0.5">Satisfacción</p>
            </div>
         </div>
      </div>
   </section>

   <!-- ─── STATS BAR ─────────────────────────────────────────────────────────── -->
   <section class="bg-brand-900 py-10 px-4">
      <div class="max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
         {
            stats.map((s, i) => (
               <div data-aos="fade-up" data-aos-delay={i * 80}>
                  <p class="text-4xl font-extrabold text-white">{s.value}</p>
                  <p class="text-brand-300 text-sm mt-1 uppercase tracking-wider">{s.label}</p>
               </div>
            ))
         }
      </div>
   </section>

   <!-- ─── NOSOTROS ─────────────────────────────────────────────────────────── -->
   <section id="nosotros" class="relative bg-white py-24 px-4 md:px-12 overflow-hidden">
      <!-- Fondo decorativo -->
      <div class="absolute inset-0 pointer-events-none">
         <div class="absolute top-0 right-0 w-2/5 h-full bg-brand-50 rounded-bl-[80px] hidden lg:block"></div>
         <div class="absolute top-16 right-10 w-5 h-5 bg-brand-300 rounded-full opacity-40"></div>
         <div class="absolute bottom-16 left-12 w-3 h-3 bg-brand-400 rounded-full opacity-30"></div>
      </div>

      <div class="relative z-10 max-w-6xl mx-auto">
         <!-- Header nosotros -->
         <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center mb-20">
            <!-- Texto -->
            <div data-aos="fade-right" data-aos-duration="900">
               <span
                  class="inline-block bg-brand-100 text-brand-800 text-xs font-semibold tracking-widest uppercase px-4 py-1.5 rounded-full mb-5"
               >
                  Quiénes somos
               </span>
               <h2 class="text-4xl md:text-5xl font-extrabold text-dark leading-tight mb-5">
                  Limpieza profesional –<br />
                  <em class="not-italic text-brand-600">con propósito real.</em>
               </h2>
               <p class="text-gray-600 text-lg leading-relaxed max-w-lg">
                  Somos Gal-Cleanup, una empresa mexicana especializada en servicios de limpieza y mantenimiento.
                  Trabajamos con compromiso, calidad y respeto al medio ambiente en cada proyecto.
               </p>
            </div>

            <!-- Imagen -->
            <div class="relative" data-aos="fade-left" data-aos-duration="900" data-aos-delay="100">
               <div class="rounded-3xl overflow-hidden shadow-2xl aspect-[4/3]">
                  <img
                     src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&q=85"
                     alt="Equipo Gal-Cleanup trabajando"
                     class="w-full h-full object-cover"
                     loading="lazy"
                  />
               </div>
               <div
                  class="absolute -bottom-5 -left-5 bg-brand-700 text-white rounded-2xl shadow-xl px-6 py-4 hidden md:block"
                  data-aos="fade-up"
                  data-aos-delay="400"
               >
                  <p class="text-3xl font-extrabold" data-count="10" data-suffix="+">10+</p>
                  <p class="text-brand-200 text-xs mt-0.5">Años de experiencia</p>
               </div>
            </div>
         </div>

         <!-- Pilares -->
         <div class="text-center mb-12" data-aos="fade-up">
            <span class="text-brand-600 text-sm font-semibold tracking-widest uppercase">Lo que nos define</span>
            <h3 class="mt-3 text-3xl font-extrabold text-dark">Nuestros pilares</h3>
            <p class="mt-3 text-gray-500 max-w-lg mx-auto text-sm">
               Cada aspecto de nuestro trabajo está guiado por valores concretos que garantizan resultados
               excepcionales.
            </p>
         </div>

         <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {
               pillars.map((p, i) => (
                  <div
                     class="group bg-white border border-gray-100 rounded-3xl p-8 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300 cursor-default"
                     data-aos="fade-up"
                     data-aos-delay={i * 80}
                  >
                     <div class="w-14 h-14 bg-brand-50 rounded-2xl flex items-center justify-center text-3xl mb-5 group-hover:bg-brand-100 transition-colors duration-300">
                        {p.icon}
                     </div>
                     <h4 class="text-xl font-extrabold text-dark mb-3">{p.title}</h4>
                     <p class="text-gray-500 leading-relaxed text-sm">{p.text}</p>
                     <div class="mt-6 h-1 w-12 bg-brand-400 rounded-full group-hover:w-20 transition-all duration-500" />
                  </div>
               ))
            }
         </div>
      </div>
   </section>

   <!-- ─── SERVICES ──────────────────────────────────────────────────────────── -->
   <section id="servicios" class="bg-brand-50 py-24 px-4 md:px-12">
      <div class="max-w-7xl mx-auto">
         <div class="text-center mb-14" data-aos="fade-up">
            <span class="text-brand-600 text-sm font-semibold tracking-widest uppercase">Lo que hacemos</span>
            <h2 class="mt-3 text-3xl md:text-5xl font-extrabold text-dark leading-tight">
               Donde el orden renace,<br />
               <em class="not-italic text-brand-700">y la limpieza inspira.</em>
            </h2>
            <p class="mt-4 text-gray-500 max-w-xl mx-auto">
               Cada espacio merece un cuidado especial. Adaptamos nuestros servicios a tus necesidades.
            </p>
         </div>

         <!-- Grid de servicios -->
         <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {
               services.map((s, i) => (
                  <div
                     class="group relative rounded-3xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-2 cursor-pointer bg-white"
                     data-aos="fade-up"
                     data-aos-delay={i * 100}
                  >
                     <div class="aspect-[3/4] relative overflow-hidden">
                        <img
                           src={s.img}
                           alt={s.title}
                           class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                           loading="lazy"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-dark/70 via-dark/10 to-transparent" />
                        <span class="absolute top-3 left-3 bg-brand-600 text-white text-xs font-semibold px-3 py-1 rounded-full">
                           {s.tag}
                        </span>
                     </div>
                     <div class="p-5">
                        <h3 class="font-bold text-dark text-lg mb-1">{s.title}</h3>
                        <p class="text-gray-500 text-sm leading-relaxed">{s.desc}</p>
                     </div>
                  </div>
               ))
            }
         </div>
      </div>
   </section>

   <!-- ─── WHY US ─────────────────────────────────────────────────────────────── -->
   <section class="bg-white py-24 px-4 md:px-12">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
         <!-- Imagen -->
         <div class="relative" data-aos="fade-right" data-aos-duration="800">
            <div class="rounded-3xl overflow-hidden shadow-xl aspect-[4/3]">
               <img
                  src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&q=80"
                  alt="Equipo Gal-Cleanup en acción"
                  class="w-full h-full object-cover"
                  loading="lazy"
               />
            </div>
            <div class="absolute -bottom-6 -right-6 bg-brand-600 text-white rounded-2xl p-5 shadow-xl hidden md:block">
               <p class="text-xs text-brand-200 uppercase tracking-wider">Nuestro método</p>
               <p class="font-bold mt-1">Auditoría &bull; Limpieza &bull; Verificación</p>
            </div>
         </div>

         <!-- Lista -->
         <div data-aos="fade-left" data-aos-duration="800">
            <span class="text-brand-600 text-sm font-semibold tracking-widest uppercase">Por qué elegirnos</span>
            <h2 class="mt-3 text-3xl md:text-4xl font-extrabold text-dark leading-tight mb-8">
               Transforma tu espacio con el<br />
               <em class="not-italic text-brand-700">toque Gal-Cleanup.</em>
            </h2>

            <div class="space-y-4">
               {
                  reasons.map((r, i) => (
                     <div class="flex items-start gap-4" data-aos="fade-up" data-aos-delay={i * 80}>
                        <div class="w-7 h-7 rounded-full bg-brand-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                           <svg
                              class="w-4 h-4 text-brand-600"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                              stroke-width="2.5"
                           >
                              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                           </svg>
                        </div>
                        <p class="text-gray-700 leading-relaxed">{r}</p>
                     </div>
                  ))
               }
            </div>

            <div class="mt-10 grid grid-cols-2 gap-4">
               <div class="bg-brand-50 rounded-2xl p-4 text-center border border-brand-100">
                  <p class="text-2xl font-extrabold text-brand-700">500+</p>
                  <p class="text-gray-500 text-sm mt-1">Reseñas positivas</p>
               </div>
               <div class="bg-brand-50 rounded-2xl p-4 text-center border border-brand-100">
                  <p class="text-2xl font-extrabold text-brand-700">200+</p>
                  <p class="text-gray-500 text-sm mt-1">Empresas atendidas</p>
               </div>
            </div>
         </div>
      </div>
   </section>

   <!-- ─── INDUSTRIES ────────────────────────────────────────────────────────── -->
   <section class="bg-brand-50 py-24 px-4 md:px-12">
      <div class="max-w-5xl mx-auto">
         <div class="text-center mb-12" data-aos="fade-up">
            <span class="text-brand-600 text-sm font-semibold tracking-widest uppercase">Sectores que atendemos</span>
            <h2 class="mt-3 text-3xl md:text-4xl font-extrabold text-dark leading-tight">
               Soluciones de limpieza para<br />
               <em class="not-italic text-brand-700">diversas industrias.</em>
            </h2>
            <p class="mt-4 text-gray-500 max-w-lg mx-auto">
               Listo para marcar la diferencia. Descubre cómo Gal-Cleanup puede potenciar la imagen de tu sector.
            </p>
         </div>

         <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
            {
               industries.map((ind, i) => (
                  <div
                     class="bg-white rounded-2xl p-5 text-center shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 border border-brand-100 cursor-default"
                     data-aos="zoom-in"
                     data-aos-delay={i * 60}
                  >
                     <span class="text-3xl">{ind.icon}</span>
                     <p class="mt-2 text-sm font-semibold text-dark">{ind.name}</p>
                  </div>
               ))
            }
         </div>
      </div>
   </section>

   <!-- ─── CONTACT FORM ─────────────────────────────────────────────────────── -->
   <section id="contacto" class="bg-white py-24 px-4 md:px-12">
      <div class="max-w-6xl mx-auto">
         <div class="text-center mb-14 reveal">
            <span class="text-brand-600 text-sm font-semibold tracking-widest uppercase">Hablemos</span>
            <h2 class="mt-3 text-3xl md:text-4xl font-extrabold text-dark leading-tight">
               ¿Listo para un espacio <em class="not-italic text-brand-600">impecable</em>?
            </h2>
            <p class="mt-3 text-gray-500 max-w-lg mx-auto">
               Completa el formulario y nos pondremos en contacto contigo lo antes posible.
            </p>
         </div>

         <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 items-start">
            <!-- Left: Contact cards -->
            <div class="lg:col-span-2 flex flex-col gap-4">
               <!-- Teléfono -->
               <div
                  class="bg-white border border-gray-100 rounded-2xl p-5 flex items-center gap-4 shadow-sm hover:shadow-md transition-shadow duration-300 reveal delay-100"
               >
                  <div class="w-14 h-14 rounded-2xl bg-brand-600 flex items-center justify-center flex-shrink-0">
                     <svg
                        class="w-6 h-6 text-white"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                     >
                        <path
                           stroke-linecap="round"
                           stroke-linejoin="round"
                           d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                        ></path>
                     </svg>
                  </div>
                  <div>
                     <p class="text-sm font-semibold text-dark">Teléfono</p>
                     <a
                        href={`tel:${siteConfigData.contacto.TELEFONO}`}
                        class="text-brand-600 font-bold hover:text-brand-700 transition-colors"
                     >
                        {siteConfigData.contacto.TELEFONO}
                     </a>
                     <p class="text-xs text-gray-400 mt-0.5">Lun - Vie: 9:00 - 18:00</p>
                  </div>
               </div>

               <!-- WhatsApp -->
               <div
                  class="bg-white border-2 border-brand-200 rounded-2xl p-5 flex items-center gap-4 shadow-sm hover:shadow-md transition-shadow duration-300 reveal delay-200"
               >
                  <div class="w-14 h-14 rounded-2xl bg-green-500 flex items-center justify-center flex-shrink-0">
                     <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                        <path
                           d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                        ></path>
                     </svg>
                  </div>
                  <div>
                     <p class="text-sm font-semibold text-dark">WhatsApp</p>
                     <a
                        href={`https://wa.me/${siteConfigData.contacto.WHATSAPP.replace(/\D/g, '')}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-brand-600 font-bold hover:text-brand-700 transition-colors flex items-center gap-1"
                     >
                        Enviar mensaje
                        <svg
                           class="w-3.5 h-3.5"
                           fill="none"
                           viewBox="0 0 24 24"
                           stroke="currentColor"
                           stroke-width="2.5"
                           ><path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                           ></path></svg
                        >
                     </a>
                     <p class="text-xs text-gray-400 mt-0.5">Respuesta inmediata</p>
                  </div>
               </div>

               <!-- Correo -->
               <div
                  class="bg-white border border-gray-100 rounded-2xl p-5 flex items-center gap-4 shadow-sm hover:shadow-md transition-shadow duration-300 reveal delay-300"
               >
                  <div class="w-14 h-14 rounded-2xl bg-violet-500 flex items-center justify-center flex-shrink-0">
                     <svg
                        class="w-6 h-6 text-white"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                     >
                        <path
                           stroke-linecap="round"
                           stroke-linejoin="round"
                           d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                        ></path>
                     </svg>
                  </div>
                  <div>
                     <p class="text-sm font-semibold text-dark">Correo Electrónico</p>
                     <a
                        href={`mailto:${siteConfigData.contacto.EMAIL}`}
                        class="text-brand-600 font-bold hover:text-brand-700 transition-colors break-all"
                     >
                        {siteConfigData.contacto.EMAIL}
                     </a>
                     <p class="text-xs text-gray-400 mt-0.5">Respuesta en 24h</p>
                  </div>
               </div>

               <!-- Mission banner -->
               <div class="rounded-2xl bg-gradient-to-br from-brand-600 to-brand-800 p-6 text-white reveal delay-400">
                  <div class="flex items-start gap-3">
                     <div
                        class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0 mt-0.5"
                     >
                        <svg
                           class="w-5 h-5 text-white"
                           fill="none"
                           viewBox="0 0 24 24"
                           stroke="currentColor"
                           stroke-width="2.5"
                        >
                           <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                     </div>
                     <div>
                        <p class="font-bold text-base">Tu satisfacción nuestra misión</p>
                        <p class="text-brand-200 text-sm mt-1 leading-relaxed">
                           Comprometidos con la excelencia en cada proyecto que realizamos
                        </p>
                     </div>
                  </div>
               </div>
            </div>

            <!-- Right: Form -->
            <div class="lg:col-span-3 bg-white border border-gray-100 rounded-3xl shadow-sm p-8 reveal-right">
               <h3 class="text-2xl font-extrabold text-dark mb-1">Envíanos un mensaje</h3>
               <p class="text-gray-500 text-sm mb-8">
                  Completa el formulario y nos pondremos en contacto contigo lo antes posible
               </p>

               <form name="contacto" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-5">
                  <input type="hidden" name="form-name" value="contacto" />
                  <p class="hidden"><input name="bot-field" /></p>

                  <!-- Row 1 -->
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                     <div>
                        <label class="block text-sm font-semibold text-dark mb-1.5"
                           >Nombre completo <span class="text-brand-500">*</span></label
                        >
                        <input
                           type="text"
                           name="nombre"
                           required
                           placeholder="Juan Pérez"
                           class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-brand-400 focus:ring-2 focus:ring-brand-100 outline-none transition-all duration-200 text-sm text-dark placeholder-gray-400"
                        />
                     </div>
                     <div>
                        <label class="block text-sm font-semibold text-dark mb-1.5"
                           >Correo electrónico <span class="text-brand-500">*</span></label
                        >
                        <input
                           type="email"
                           name="email"
                           required
                           placeholder="tu@email.com"
                           class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-brand-400 focus:ring-2 focus:ring-brand-100 outline-none transition-all duration-200 text-sm text-dark placeholder-gray-400"
                        />
                     </div>
                  </div>

                  <!-- Row 2 -->
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                     <div>
                        <label class="block text-sm font-semibold text-dark mb-1.5">Teléfono</label>
                        <input
                           type="tel"
                           name="telefono"
                           placeholder="+52 55 1234 5678"
                           class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-brand-400 focus:ring-2 focus:ring-brand-100 outline-none transition-all duration-200 text-sm text-dark placeholder-gray-400"
                        />
                     </div>
                     <div>
                        <label class="block text-sm font-semibold text-dark mb-1.5">Servicio de interés</label>
                        <select
                           name="servicio"
                           class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-brand-400 focus:ring-2 focus:ring-brand-100 outline-none transition-all duration-200 text-sm text-dark bg-white"
                        >
                           <option value="" disabled selected>Selecciona un servicio</option>
                           <option value="residencial">Limpieza Residencial</option>
                           <option value="comercial">Limpieza Comercial</option>
                           <option value="oficinas">Limpieza de Oficinas</option>
                           <option value="post-obra">Limpieza Post-Obra</option>
                           <option value="otro">Otro</option>
                        </select>
                     </div>
                  </div>

                  <!-- Mensaje -->
                  <div>
                     <label class="block text-sm font-semibold text-dark mb-1.5"
                        >Mensaje <span class="text-brand-500">*</span></label
                     >
                     <textarea
                        name="mensaje"
                        required
                        rows="5"
                        placeholder="Cuéntanos sobre tu proyecto o necesidades..."
                        class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-brand-400 focus:ring-2 focus:ring-brand-100 outline-none transition-all duration-200 text-sm text-dark placeholder-gray-400 resize-none"
                     ></textarea>
                  </div>

                  <!-- Privacy -->
                  <div class="flex items-start gap-3">
                     <input
                        type="checkbox"
                        id="privacy"
                        name="privacidad"
                        required
                        class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-600 focus:ring-brand-400 cursor-pointer"
                     />
                     <label for="privacy" class="text-sm text-gray-500 cursor-pointer">
                        Acepto el
                        <a href="/privacypolicy" class="text-brand-600 underline hover:text-brand-700 transition-colors"
                           >Aviso de Privacidad</a
                        >
                     </label>
                  </div>

                  <!-- Submit -->
                  <button
                     type="submit"
                     class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-brand-700 hover:bg-brand-800 active:scale-95 text-white font-bold px-10 py-4 rounded-xl transition-all duration-200 shadow-md hover:shadow-brand-700/30 text-sm tracking-wide"
                  >
                     Enviar mensaje &rarr;
                  </button>
               </form>
            </div>
         </div>
      </div>
   </section>
</Layout>
