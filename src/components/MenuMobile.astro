---
import HamburgerIcon from '@assets/HamburgerIcon.astro';
import CloseIcon from '@assets/CloseIcon.astro';
---

<div class="md:hidden relative">
   <!-- Botón de menú hamburguesa -->
   <button
      id="menuButton"
      class="flex justify-center items-center w-8 h-8 gap-1 focus:outline-none"
      aria-label="Abrir menú"
   >
      <div id="hamburgerIcon" class="">
         <HamburgerIcon size={5} />
      </div>

      <div id="closeIcon" class="hidden">
         <CloseIcon size={5} />
      </div>
   </button>

   <!-- Menú desplegable -->
   <nav
      id="menuNav"
      class="absolute top-12 right-0 w-max bg-white/95 backdrop-blur-md shadow-xl border border-gray-100 rounded-2xl p-4 flex flex-col gap-2 z-50 hidden"
   >
      <a href="/" class="text-dark text-sm font-medium hover:text-brand-700 transition-colors px-2 py-1">Inicio</a>
      <a href="/#nosotros" class="text-dark text-sm font-medium hover:text-brand-700 transition-colors px-2 py-1"
         >Nosotros</a
      >
      <a href="/#servicios" class="text-dark text-sm font-medium hover:text-brand-700 transition-colors px-2 py-1"
         >Servicios</a
      >
      <a href="/#contacto" class="text-dark text-sm font-medium hover:text-brand-700 transition-colors px-2 py-1"
         >Contacto</a
      >
      <div class="border-t border-gray-100 mt-1 pt-2">
         <a
            href="https://wa.me/5215578767442"
            target="_blank"
            rel="noopener noreferrer"
            class="block bg-brand-700 hover:bg-brand-800 text-white text-sm font-semibold px-4 py-2 rounded-xl transition-colors text-center"
            >Cotiza ya &rarr;</a
         >
      </div>
   </nav>
</div>

<script>
   // Obtenemos los elementos
   const menuButton = document.getElementById('menuButton');
   const hamburgerIcon = document.getElementById('hamburgerIcon');
   const closeIcon = document.getElementById('closeIcon');
   const menuNav = document.getElementById('menuNav');

   // Manejar el clic en el botón del menú
   menuButton.addEventListener('click', () => {
      // Alternamos el menú visible/oculto
      menuNav.classList.toggle('hidden');

      // Alternamos la visibilidad de los íconos
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
   });
</script>
